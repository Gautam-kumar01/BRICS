# ==========================================
# BRICS CivicPulse Environment Configuration
# ==========================================

# Database: Neon Serverless PostgreSQL
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=

# AI Provider 1: Google Gemini (High Reasoning & Multilingual Extraction)
GEMINI_API_KEY=

# AI Provider 2: Groq (Ultra-low latency Llama-3 70B / 8B for real-time speech-to-intent)
GROQ_API_KEY=

# AI Provider 3: OpenRouter (Universal AI Aggregator - Claude, DeepSeek, Mistral fallback)
OPENROUTER_API_KEY=

# Authentication: Clerk Security & Session Control
# (Government officer sign-in only; citizen zero-login is fully supported)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/operations

# Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
