# ==============================================================================
# BRICS CivicPulse - Production Environment Variables (.env)
# ==============================================================================

# 1. AI Switchboard Providers (Optional - Built-in Local NLP works automatically without keys)
# ------------------------------------------------------------------------------
# Google Gemini (Multimodal reasoning & multilingual intent extraction)
GEMINI_API_KEY=

# Groq LPU (Ultra-fast ~85ms real-time speech-to-intent with Llama 3.3)
GROQ_API_KEY=

# OpenRouter (Universal AI Aggregator fallback)
OPENROUTER_API_KEY=


# 2. Transactional Email Gateway (Optional - Simulated GovTech Mail modal active by default)
# ------------------------------------------------------------------------------
# Resend API Key (Used to dispatch real activation emails to provisioned government officials)
# Get your free key at: https://resend.com
RESEND_API_KEY=


# 3. Database: Neon Serverless PostgreSQL (Optional - In-Memory Store active by default)
# ------------------------------------------------------------------------------
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=


# 4. Public Application URL (For production email activation links)
# ------------------------------------------------------------------------------
# In Vercel, this is your deployment URL (e.g. https://brics-civicpulse.vercel.app)
NEXT_PUBLIC_APP_URL=https://brics-civicpulse.vercel.app
